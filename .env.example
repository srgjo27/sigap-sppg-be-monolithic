APP_ENV=
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:password_anda@127.0.0.1:5432/nama_database_anda
JWT_SECRET=ganti-dengan-secret-minimal-32-karakter
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
BCRYPT_COST=12
CORS_ALLOWED_ORIGINS=
# Object storage (S3-compatible, untuk upload foto)
# Endpoint tanpa https://, misal 127.0.0.1:9000. Semua baris wajib terisi
# agar endpoint /api/v1/uploads aktif; kosong berarti fitur unggahan mati.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=
# "1" atau "true" memakai HTTPS; kosong = HTTP (dev MinIO lokal)
STORAGE_USE_TLS=
